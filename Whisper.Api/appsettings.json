{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=your-host.pooler.supabase.com;Port=5432;Database=postgres;Username=your-username;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
  },
  "JwtSettings": {
    "Secret": "YOUR_JWT_SECRET_KEY_MIN_32_CHARACTERS_LONG",
    "Issuer": "WhisperApi",
    "Audience": "WhisperClient",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Supabase": {
    "Url": "https://your-project-ref.supabase.co",
    "Key": "YOUR_SUPABASE_SERVICE_KEY",
    "BucketName": "whisper-bucket"
  },
  "PredefinedUsers": {
    "User1": {
      "Username": "user1",
      "Password": "YOUR_USER1_PASSWORD"
    },
    "User2": {
      "Username": "user2",
      "Password": "YOUR_USER2_PASSWORD"
    }
  }
}
